#!/usr/bin/env php
<?php
declare(strict_types=1);

use App\Discovering\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Dotenv\Dotenv;

require dirname(__DIR__) . '/vendor/autoload.php';

if (class_exists(Dotenv::class) && file_exists(dirname(__DIR__) . '/.env')) {
    (new Dotenv())->bootEnv(dirname(__DIR__) . '/.env');
}

$input = new ArgvInput();
$environment = (string) $input->getParameterOption(['--env', '-e'], $_SERVER['APP_ENV'] ?? 'dev', true);
$debug = !$input->hasParameterOption('--no-debug', true) && (bool) ($_SERVER['APP_DEBUG'] ?? true);

$kernel = new Kernel($environment, $debug);
$application = new Application($kernel);
$application->run($input);
