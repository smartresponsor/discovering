{% extends 'base.html.twig' %}

{% block title %}Discovery Management{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h1 class="mb-2">Discovery Management</h1>
            <p class="text-muted mb-0">Operator-facing overview for discovery backends, rebuild flows, diagnostics, and source coverage.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_libsource') }}">Libsource</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_playbook') }}">Playbook</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_briefing') }}">Briefing</a>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Backend</h2>
                    <div class="fs-5">{{ overview.backendName }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Total documents</h2>
                    <div class="fs-5">{{ overview.totalDocuments }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="h5 mb-1">State topology</h2>
                    <p class="text-muted mb-0">Mutable discovery state paths and distributed-readiness posture.</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_state_topology_export') }}">Export topology</a>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Local state root</div>
                        <div><code>{{ stateTopology.localStateRoot }}</code></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Shared state configured</div>
                        <div class="fw-semibold">{{ stateTopology.sharedStateConfigured ? 'yes' : 'no' }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Distributed ready</div>
                        <div class="fw-semibold">{{ stateTopology.distributedReady ? 'yes' : 'no' }}</div>
                    </div>
                </div>
            </div>

            <table class="table mt-3 mb-0">
                <thead>
                    <tr>
                        <th>Store</th>
                        <th>Backend</th>
                        <th>Mode</th>
                        <th>Shared</th>
                        <th>Multi-replica write-ready</th>
                    </tr>
                </thead>
                <tbody>
                    {% for store in stateTopology.stores %}
                        <tr>
                            <td>{{ store.name }}</td>
                            <td>{{ store.backend }}</td>
                            <td>{{ store.storageMode }}</td>
                            <td>{{ store.sharedConfigured ? 'yes' : 'no' }}</td>
                            <td>{{ store.multiReplicaWriteReady ? 'yes' : 'no' }}</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="small text-muted">
                                <div><code>{{ store.path }}</code></div>
                                {% if store.concerns is not empty %}
                                    <div class="mt-1">Concerns: {{ store.concerns|join(', ') }}</div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if stateTopology.notes is not empty %}
                <div class="mt-3">
                    <h3 class="h6 text-muted">Topology notes</h3>
                    <ul class="mb-0">
                        {% for note in stateTopology.notes %}
                            <li>{{ note }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="h5 mb-1">Platform diagnostics</h2>
                    <p class="text-muted mb-0">Operator-facing snapshot of adapter capability, distributed readiness, and rollback posture.</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_platform_export') }}">Export platform diagnostics</a>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Index store backend</div>
                        <div class="fw-semibold">{{ platformDiagnostics.indexStoreBackend }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Staged rebuild supported</div>
                        <div class="fw-semibold">{{ platformDiagnostics.stagedRebuildSupported ? 'yes' : 'no' }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Rollback status</div>
                        <div class="fw-semibold">{{ platformDiagnostics.rollbackStatus }}</div>
                    </div>
                </div>
            </div>

            <table class="table mt-3 mb-0">
                <tbody>
                    <tr>
                        <th>Active adapter backend</th>
                        <td>{{ platformDiagnostics.backendName }}</td>
                    </tr>
                    <tr>
                        <th>Shared state configured</th>
                        <td>{{ platformDiagnostics.sharedStateConfigured ? 'yes' : 'no' }}</td>
                    </tr>
                    <tr>
                        <th>Distributed ready</th>
                        <td>{{ platformDiagnostics.distributedReady ? 'yes' : 'no' }}</td>
                    </tr>
                    <tr>
                        <th>Rollback ready</th>
                        <td>{{ platformDiagnostics.rollbackReady ? 'yes' : 'no' }}</td>
                    </tr>
                    <tr>
                        <th>Multi-replica-ready stores</th>
                        <td>{{ platformDiagnostics.coordinationReadyStoreCount }}</td>
                    </tr>
                    <tr>
                        <th>Blocking stores</th>
                        <td>{% if platformDiagnostics.blockingStores is empty %}none{% else %}{{ platformDiagnostics.blockingStores|join(', ') }}{% endif %}</td>
                    </tr>
                </tbody>
            </table>

            {% if platformDiagnostics.notes is not empty %}
                <div class="mt-3">
                    <h3 class="h6 text-muted">Platform notes</h3>
                    <ul class="mb-0">
                        {% for note in platformDiagnostics.notes %}
                            <li>{{ note }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="h5 mb-1">Rollback posture</h2>
                    <p class="text-muted mb-0">Current rollback plan derived from rebuild evidence history.</p>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" action="{{ path('app_management_discovery_rollback_execute') }}">
                        <input type="hidden" name="current" value="{{ rollbackPlan.currentEvidenceId ?? '' }}">
                        <input type="hidden" name="target" value="{{ rollbackPlan.previousEvidenceId ?? '' }}">
                        <button class="btn btn-outline-danger btn-sm" type="submit" {% if not rollbackPlan.rollbackReady %}disabled{% endif %}>Execute rollback</button>
                    </form>
                    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_rollback_export') }}">Export rollback plan</a>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Status</div>
                        <div class="fw-semibold">{{ rollbackPlan.status }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Rollback ready</div>
                        <div class="fw-semibold">{{ rollbackPlan.rollbackReady ? 'yes' : 'no' }}</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Recommended command</div>
                        <div class="small"><code>{{ rollbackPlan.recommendedCommand ?? 'n/a' }}</code></div>
                    </div>
                </div>
            </div>

            <table class="table mt-3 mb-0">
                <tbody>
                    <tr>
                        <th>Current evidence</th>
                        <td><code>{{ rollbackPlan.currentEvidenceId ?? 'n/a' }}</code></td>
                    </tr>
                    <tr>
                        <th>Previous evidence</th>
                        <td><code>{{ rollbackPlan.previousEvidenceId ?? 'n/a' }}</code></td>
                    </tr>
                    <tr>
                        <th>Current physical index</th>
                        <td><code>{{ rollbackPlan.currentPhysicalIndex ?? 'n/a' }}</code></td>
                    </tr>
                    <tr>
                        <th>Rollback target physical index</th>
                        <td><code>{{ rollbackPlan.rollbackTargetPhysicalIndex ?? 'n/a' }}</code></td>
                    </tr>
                </tbody>
            </table>

            {% if rollbackPlan.notes is not empty %}
                <div class="mt-3">
                    <h3 class="h6 text-muted">Operator notes</h3>
                    <ul class="mb-0">
                        {% for note in rollbackPlan.notes %}
                            <li>{{ note }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <h2 class="h5 mb-0">Recent operations</h2>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_operations_export') }}">Export operations</a>
            </div>
            <table class="table mt-3 mb-0">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Operation</th>
                        <th>Request</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for operation in operations %}
                        <tr>
                            <td>{{ operation.occurredAt }}</td>
                            <td>{{ operation.operation }}</td>
                            <td><code>{{ operation.requestId }}</code></td>
                            <td>{{ operation.status }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-muted">No operations have been recorded yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h5">Coverage by resource type</h2>
            <table class="table mt-3 mb-0">
                <thead>
                    <tr>
                        <th>Resource type</th>
                        <th class="text-end">Documents</th>
                    </tr>
                </thead>
                <tbody>
                    {% for resourceType, count in overview.countsByResourceType %}
                        <tr>
                            <td>{{ resourceType }}</td>
                            <td class="text-end">{{ count }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h5">Coverage by source</h2>
            <table class="table mt-3 mb-0">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="text-end">Records</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sourceName, count in overview.countsBySourceName %}
                        <tr>
                            <td>{{ sourceName }}</td>
                            <td class="text-end">{{ count }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h5">Seeded sample documents</h2>
            <div class="list-group mt-3">
                {% for document in overview.sampleDocuments %}
                    <div class="list-group-item">
                        <div class="fw-semibold">{{ document.title }}</div>
                        <div class="small text-muted">{{ document.resource }} / {{ document.id }}</div>
                        <div class="mt-2">{{ document.content }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
