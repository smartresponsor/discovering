{% extends 'base.html.twig' %}

{% block title %}Discovery Management{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-3">Discovery Management</h1>
    <p class="text-muted">Operator-facing overview for discovery backends, rebuild flows, and diagnostics.</p>

    <div class="row g-4 mt-1">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Backend</h2>
                    <div class="fs-5">{{ overview.backendName }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Total documents</h2>
                    <div class="fs-5">{{ overview.totalDocuments }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h5">Coverage by resource type</h2>
            <table class="table mt-3 mb-0">
                <thead>
                    <tr>
                        <th>Resource type</th>
                        <th class="text-end">Documents</th>
                    </tr>
                </thead>
                <tbody>
                    {% for resourceType, count in overview.countsByResourceType %}
                        <tr>
                            <td>{{ resourceType }}</td>
                            <td class="text-end">{{ count }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h5">Seeded sample documents</h2>
            <div class="list-group mt-3">
                {% for document in overview.sampleDocuments %}
                    <div class="list-group-item">
                        <div class="fw-semibold">{{ document.title }}</div>
                        <div class="small text-muted">{{ document.resourceType }} / {{ document.resourceId }}</div>
                        <div class="mt-2">{{ document.body }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
