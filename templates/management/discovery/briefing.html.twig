{% extends 'management/discovery/directory_backed_family_management.html.twig' %}

{% block family_title %}Briefing Management{% endblock %}
{% block family_heading %}Briefing Management{% endblock %}
{% block family_description %}Operator-facing surface for the file-backed briefing discovery source.{% endblock %}

{% block family_navigation %}
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_libsource') }}">Libsource</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_playbook') }}">Playbook</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_briefing_export') }}">Export JSON</a>
{% endblock %}

{% block family_actions %}
    <a class="btn btn-primary btn-sm" href="{{ path('app_management_discovery_briefing', { action: 'audit-registry' }) }}">Audit registry</a>
    <a class="btn btn-outline-primary btn-sm" href="{{ path('app_management_discovery_briefing', { action: 'ensure-sample-registry' }) }}">Ensure sample registry</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_briefing', { action: 'migrate-legacy-storage' }) }}">Migrate legacy storage</a>
{% endblock %}

{% block empty_source_files_message %}No briefing source files are currently present.{% endblock %}
{% block live_records_heading %}Live briefing records{% endblock %}
{% block empty_records_message %}No briefing records are currently stored.{% endblock %}
{% block operational_note %}Briefings are intended for concise contextual and explanatory live materials, distinct from procedural playbooks. Use <code>app:discovery:briefing:history</code> to review the current operator event trail from CLI, or the export endpoint to inspect the aggregated live source state.{% endblock %}
