{% extends 'management/discovery/directory_backed_family_management.html.twig' %}

{% block family_title %}Playbook Management{% endblock %}
{% block family_heading %}Playbook Management{% endblock %}
{% block family_description %}Operator-facing surface for the file-backed playbook discovery source.{% endblock %}

{% block family_navigation %}
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_libsource') }}">Libsource</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_briefing') }}">Briefing</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_playbook_export') }}">Export JSON</a>
{% endblock %}

{% block family_actions %}
    <a class="btn btn-primary btn-sm" href="{{ path('app_management_discovery_playbook', { action: 'audit-registry' }) }}">Audit registry</a>
    <a class="btn btn-outline-primary btn-sm" href="{{ path('app_management_discovery_playbook', { action: 'ensure-sample-registry' }) }}">Ensure sample registry</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_management_discovery_playbook', { action: 'migrate-legacy-storage' }) }}">Migrate legacy storage</a>
{% endblock %}

{% block empty_source_files_message %}No playbook source files are currently present.{% endblock %}
{% block live_records_heading %}Live playbook records{% endblock %}
{% block empty_records_message %}No playbook records are currently stored.{% endblock %}
{% block operational_note %}Use <code>app:discovery:playbook:import</code> to write records into the directory-backed live source registry, <code>app:discovery:playbook:export</code> to export the aggregated current live source state, or <code>app:discovery:playbook:history</code> to review the current operator event trail from CLI.{% endblock %}
