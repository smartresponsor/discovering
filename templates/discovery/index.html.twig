{% extends 'base.html.twig' %}

{% block title %}Discovering{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-3">Discovering</h1>
    <p class="text-muted">Application resource discovery workspace</p>

    {{ form_start(form, { method: 'GET' }) }}
    <div class="row g-3 align-items-end mb-3">
        <div class="col-md-3">{{ form_row(form.query) }}</div>
        <div class="col-md-2">{{ form_row(form.mode) }}</div>
        <div class="col-md-2">{{ form_row(form.resource) }}</div>
        <div class="col-md-2">{{ form_row(form.status) }}</div>
        <div class="col-md-1">{{ form_row(form.limit) }}</div>
        <div class="col-md-2">{{ form_row(form.offset) }}</div>
    </div>
    <div class="row g-3 align-items-end mb-4">
        <div class="col-md-4">{{ form_row(form.project_weight) }}</div>
        <div class="col-md-4">{{ form_row(form.offering_weight) }}</div>
        <div class="col-md-4">{{ form_row(form.document_weight) }}</div>
    </div>
    <div class="row g-3 align-items-end mb-4">
        <div class="col-md-6">{{ form_row(form.playbook_weight) }}</div>
        <div class="col-md-6">{{ form_row(form.briefing_weight) }}</div>
    </div>
    <button class="btn btn-primary">Discover</button>
    {{ form_end(form) }}

    <hr class="my-4" />

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Engine query summary</h2>
            <div class="row g-3 small">
                <div class="col-md-3">
                    <div class="text-muted">Query</div>
                    <div>{{ query.query is same as('') ? '—' : query.query }}</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted">Mode</div>
                    <div><span class="badge text-bg-dark">{{ query.mode }}</span></div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted">Resource scope</div>
                    <div>{{ query.resource }}</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted">Status filter</div>
                    <div>{{ query.filters.status|default('—') }}</div>
                </div>
            </div>
            <div class="row g-3 small mt-1">
                <div class="col-md-12">
                    <div class="text-muted">Effective weights</div>
                    <div>
                        {% if query.resourceWeights is empty %}
                            —
                        {% else %}
                            {% for resource, weight in query.resourceWeights %}
                                <span class="badge text-bg-light">{{ resource }} × {{ weight }}</span>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5">Results ({{ result.total }})</h2>

    {% if result.hits is empty %}
        <div class="alert alert-light border">No discovery hits yet.</div>
    {% else %}
        <div class="list-group">
            {% for hit in result.hits %}
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div class="fw-semibold">{{ hit.highlightedTitle|raw }}</div>
                                <span class="badge text-bg-primary">Score {{ hit.score }}</span>
                                {% if hit.ftsScore is not null %}
                                    <span class="badge text-bg-info">FTS {{ hit.ftsScore|number_format(4, '.', '') }}</span>
                                {% endif %}
                                <span class="badge text-bg-secondary">{{ hit.status }}</span>
                            </div>
                            <div class="small text-muted mt-1">{{ hit.resource }} · {{ hit.highlightedReference|raw }}</div>

                            {% if hit.highlightedSnippet is not same as('') %}
                                <div class="mt-3 p-3 bg-body-tertiary rounded border small">
                                    {{ hit.highlightedSnippet|raw }}
                                </div>
                            {% endif %}

                            {% if hit.matchedTokens is not empty %}
                                <div class="mt-2">
                                    <div class="small text-muted mb-1">Matched tokens</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for token in hit.matchedTokens %}
                                            <span class="badge rounded-pill text-bg-warning-subtle border">{{ token }}</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            {% if hit.matchReasons is not empty %}
                                <div class="mt-3">
                                    <div class="small text-muted mb-1">Why this ranked here</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for reason in hit.matchReasons %}
                                            <span class="badge rounded-pill text-bg-light">{{ reason }}</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
