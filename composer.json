{
  "name": "discovering/discovery",
  "description": "Discovering process app",
  "type": "project",
  "license": "proprietary",
  "require": {
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "php": ">=8.4",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/error-handler": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/yaml": "^8.1",
    "twig/twig": "^3.0",
    "doctrine/orm": "3.6",
    "doctrine/doctrine-bundle": "3.2",
    "objecting/object": "*@dev"
  },
  "autoload": {
    "psr-4": {
      "App\\Discovering\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Discovering\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/dom-crawler": "^8.1",
    "friendsofphp/php-cs-fixer": "^3.66",
    "nelmio/api-doc-bundle": "^5.6",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "test": "phpunit",
    "lint:php": "php tools/lint_php.php",
    "validate:composer": "composer validate --strict",
    "verify:runtime-preflight": "php tools/runtime_preflight.php",
    "verify:console": "php bin/console list --raw",
    "test:unit": "phpunit --testsuite Unit",
    "test:object-identity": "phpunit tests/Unit/Discovery/DiscoveringObjectIdentityContractTest.php",
    "test:functional": "phpunit --testsuite Functional",
    "test:contract": "phpunit --testsuite Contract",
    "test:behavioral": "phpunit --testsuite Behavioral",
    "test:all": [
      "@test:unit",
      "@test:contract",
      "@test:behavioral",
      "@test:functional"
    ],
    "ci": [
      "@ci:local",
      "@ci:runtime",
      "@ci:quality"
    ],
    "analyse": "php tools/qa_guard.php analyse",
    "lint:cs": "php tools/qa_guard.php lint:cs",
    "lint:cs:fix": "php tools/qa_guard.php lint:cs:fix",
    "verify:docblocks": "php tools/docblock_policy_check.php",
    "verify:security": "php tools/security_preflight.php",
    "docs:openapi:dump:public": "php tools/qa_guard.php docs:openapi:dump:public",
    "docs:openapi:dump:management": "php tools/qa_guard.php docs:openapi:dump:management",
    "verify:runtime-extensions": "php tools/runtime_preflight.php --check-runtime-extensions",
    "verify:composer-runtime": "php tools/runtime_preflight.php --require-composer",
    "verify:vendor-runtime": "php tools/runtime_preflight.php --require-vendor",
    "verify:test-runtime": "php tools/runtime_preflight.php --test-runtime",
    "ci:local": [
      "@validate:composer",
      "@verify:runtime-preflight",
      "@verify:security",
      "@verify:docblocks",
      "@lint:php"
    ],
    "ci:runtime": [
      "@verify:composer-runtime",
      "@verify:vendor-runtime",
      "@verify:runtime-extensions",
      "@verify:test-runtime",
      "@verify:console",
      "@test:all"
    ],
    "ci:quality": [
      "@analyse",
      "@lint:cs"
    ],
    "ci:local:direct": "php tools/local_ci.php",
    "verify:structural-closure": "php tools/structural_closure_evidence.php",
    "verify:runtime-dependency-evidence": "php tools/runtime_dependency_evidence.php",
    "verify:console-container-evidence": "php tools/console_container_evidence.php",
    "verify:evidence-index": "php tools/evidence_index.php",
    "verify:evidence-summary": "php tools/evidence_summary.php",
    "verify:evidence-bundle": "php tools/evidence_bundle.php",
    "evidence:cleanup": "php tools/evidence_artifact_cleanup.php",
    "evidence:cleanup:dry-run": "php tools/evidence_artifact_cleanup.php --dry-run"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true
      }
    }
  ]
}

